# Neo4j AuraDB (server-side only — never expose these in the frontend)
NEO4J_URI=neo4j+s://YOUR-INSTANCE.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-aura-password

# Express API
PORT=4000

# Optional: raises GitHub API rate limits for ingestion
GITHUB_TOKEN=

# Optional: used only to phrase answers from retrieved Neo4j/GitHub evidence.
# If unset, CodeWhy returns structured evidence-based answers without an LLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
